{
  "version": "1.0",
  "description": "Layer split configuration for distributed LLM inference between macOS and Windows hosts",
  "defaults": {
    "split_mode": "layer",
    "cache_type_k": "q8_0",
    "cache_type_v": "q8_0",
    "micro_batch": 2,
    "context": 4096,
    "worker_port": 50052
  },
  "hardware_profiles": {
    "mac-mini-m2-pro-24gb": {
      "description": "Mac Mini M2 Pro with 24 GB unified memory",
      "mac_memory_gb": 24,
      "metal_available": true,
      "recommended_split_ratio": 0.65
    },
    "macbook-m2-16gb": {
      "description": "MacBook M2 with 16 GB unified memory",
      "mac_memory_gb": 16,
      "metal_available": true,
      "recommended_split_ratio": 0.55
    },
    "macbook-m3-pro-18gb": {
      "description": "MacBook Pro M3 Pro with 18 GB unified memory",
      "mac_memory_gb": 18,
      "metal_available": true,
      "recommended_split_ratio": 0.60
    }
  },
  "worker_profiles": {
    "rx-6700-xt-12gb": {
      "description": "AMD RX 6700 XT with 12 GB VRAM",
      "vram_gb": 12,
      "backend": "vulkan"
    },
    "rx-7900-xtx-24gb": {
      "description": "AMD RX 7900 XTX with 24 GB VRAM",
      "vram_gb": 24,
      "backend": "rocm"
    },
    "rx-6600-8gb": {
      "description": "AMD RX 6600 with 8 GB VRAM",
      "vram_gb": 8,
      "backend": "vulkan"
    }
  },
  "example_combinations": [
    {
      "mac": "mac-mini-m2-pro-24gb",
      "worker": "rx-6700-xt-12gb",
      "total_budget_gb": 31.2,
      "recommended_split": 0.68,
      "max_model_size_gb": 48,
      "recommended_quant": "Q4_K_M",
      "note": "Can run 70B Q4_K_M with layer splitting"
    },
    {
      "mac": "macbook-m2-16gb",
      "worker": "rx-6600-8gb",
      "total_budget_gb": 16.8,
      "recommended_split": 0.62,
      "max_model_size_gb": 13,
      "recommended_quant": "Q5_K_M",
      "note": "Best for 13B models at Q5_K_M"
    }
  ]
}
